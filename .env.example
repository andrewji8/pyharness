# PyHarness environment configuration (EXAMPLE — copy to .env and fill in)
# Never commit the real .env file; it is git-ignored.

# --- LLM provider (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Eval framework overrides (optional) ---
# PYHARNESS_MODEL=dummy
# PYHARNESS_JUDGE_MODEL=dummy
PYHARNESS_MODEL=your_eval_model_here
PYHARNESS_JUDGE_MODEL=your_judge_model_here
