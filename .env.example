# PyHarness environment configuration
# Copy to `.env` and fill in real values. Never commit secrets to the repo.

# LLM provider — OpenAI-compatible API (DeepSeek, OpenAI, vLLM, etc.)
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.deepseek.com/v1"

# --- Distributed agent cluster (Redis) ---
# Enable distributed tool execution. When "1" AND REDIS_URL is set, tool
# execution is offloaded to `pyharness worker` processes. Otherwise the web
# node executes tools in-process.
PYHARNESS_DISTRIBUTED_EXEC="0"

# Redis connection URL used by the distributed session store, event bus, and
# task queue.
REDIS_URL="redis://127.0.0.1:6379/0"
